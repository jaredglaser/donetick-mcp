# Donetick instance origin. No trailing path. http is allowed for LAN addresses.
DONETICK_URL="https://donetick.example.com"

# API token from Donetick: Settings -> Access Tokens. Sent as the `secretkey` header.
# This is not your password. Revoke it from the same screen.
DONETICK_TOKEN=""

# IANA zone used when a chore carries no timezone of its own. Defaults to the system zone.
# DONETICK_TZ="America/New_York"

# Chore-list cache lifetime in ms. 0 disables caching.
# DONETICK_CACHE_TTL_MS="10000"

# Per-request timeout in ms.
# DONETICK_TIMEOUT_MS="15000"
